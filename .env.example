# Copy to .env.local (or set in your shell). All values are optional; the defaults are shown.
# .env* files are git-ignored. Never put real OAuth secrets in frontend code.

# API server (binds to loopback only by default)
MIRA_API_HOST=127.0.0.1
MIRA_API_PORT=8787

# SQLite database file (created on first run)
MIRA_DB_PATH=./data/mira.sqlite

# Insert the prototype's demo tasks when a brand-new database is created (never on later starts)
MIRA_SEED=true

# Time zone used by the server for "today" (defaults to this machine's zone), e.g. Asia/Kolkata
# MIRA_TIME_ZONE=

# Port of the Vite dev server; its origin is trusted automatically
PORT=8443

# Extra trusted browser origins / Host names, comma-separated
# MIRA_ALLOWED_ORIGINS=
# MIRA_ALLOWED_HOSTS=

# Log method, path and status of each request (never bodies)
MIRA_LOG_REQUESTS=true

# Future Google integration. Setting these does NOT enable sign-in yet: the OAuth flow is not implemented,
# and the server will say so instead of pretending to connect.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
